	(gr_text "RF DESIGN RULES AND CALCULATIONS:\n50 ohm is 0.17mm with cst studio and 0.156 with jlcpcb.\nI chose 0.17mm.\nDifferential 50 ohm is approximately 0.4mm.\nGround pour on layer 1 to rf trace edge should be at least \n3 x substrate height which is 0.3mm for jlcpcb stackup.\nVia distance next to rf trace is 1mm and 0.6mm away from edge of the trace\nThis distance can be 2 3 mm after first row (for empty areas etc.)"
		(at 205.55 -43 0)
		(layer "F.SilkS")
		(uuid "e13018b4-f32a-4130-be13-a79fc0e284b4")
		(effects
			(font
				(size 2 2)
				(thickness 0.5)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "USB trace differential is 90ohm\n0.23mm 0.13mm space makes 100ohm for oshpark\nand 85 ohm for jlcpcb it is ok.\n\nJLC06161H-3313 is selected for rf 50 ohm and usb 90 ohm"
		(at 205.55 -19 0)
		(layer "F.SilkS")
		(uuid "e365e069-9869-4edf-ba34-25b1748556d8")
